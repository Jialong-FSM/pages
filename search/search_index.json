{"config":{"lang":["en"],"separator":"[\\s\\u200b\\u3000\\-\u3001\u3002\uff0c\uff0e\uff1f\uff01\uff1b]+","pipeline":["stemmer"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u73bb\u7483\u8d44\u6599","text":"<p>\u8fd9\u662f\u73bb\u7483\u8d44\u6599\u7684\u9759\u6001\u7f51\u9875\u7248\u672c\u3002</p> <ul> <li>\u67e5\u770b\u73bb\u7483\u6587\u6863</li> </ul>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/","title":"==\u95ee\u9898\u4e00\uff1a\u73bb\u7483\u5e55\u5899\u4e0a\u6240\u4f7f\u7528\u7684\u53cc\u5c42\u4e2d\u7a7a\u5939\u5fc3\u73bb\u7483\u7684 low-e \u662f\u4ec0\u4e48\u610f\u601d\uff1f==","text":"<p>\u73bb\u7483\u5e55\u5899\u7528\u7684\u53cc\u5c42\u4e2d\u7a7a\u73bb\u7483\u91cc\u8bf4\u7684 Low-E\uff0c\u5168\u79f0\u662f Low Emissivity\uff0c\u4e2d\u6587\u901a\u5e38\u53eb\uff1a\u4f4e\u8f90\u5c04\u73bb\u7483 \u6216 Low-E \u9540\u819c\u73bb\u7483\u3002\u5b83\u7684\u6838\u5fc3\u610f\u601d\u662f\uff1a\u5728\u73bb\u7483\u8868\u9762\u9540\u4e86\u4e00\u5c42\u975e\u5e38\u8584\u7684\u91d1\u5c5e\u6216\u91d1\u5c5e\u6c27\u5316\u7269\u819c\u5c42\uff0c\u7528\u6765\u964d\u4f4e\u73bb\u7483\u5bf9\u8fdc\u7ea2\u5916\u70ed\u8f90\u5c04\u7684\u53d1\u5c04\u548c\u5438\u6536\u80fd\u529b\u3002</p> <p>\u901a\u4fd7\u8bf4\uff0cLow-E \u73bb\u7483\u4e0d\u662f\u666e\u901a\u900f\u660e\u73bb\u7483\uff0c\u800c\u662f\u201c\u5e26\u8282\u80fd\u9540\u819c\u7684\u73bb\u7483\u201d\u3002</p>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#low-e-e","title":"Low-E \u91cc\u7684 E \u662f\u4ec0\u4e48\u610f\u601d\uff1f","text":"<p>E = Emissivity\uff0c\u53d1\u5c04\u7387 / \u8f90\u5c04\u7387\u3002</p> <p>\u7269\u4f53\u53d7\u70ed\u540e\u4f1a\u5411\u5916\u8f90\u5c04\u70ed\u91cf\u3002\u666e\u901a\u73bb\u7483\u7684\u8f90\u5c04\u7387\u6bd4\u8f83\u9ad8\uff0c\u5ba4\u5185\u70ed\u91cf\u5bb9\u6613\u901a\u8fc7\u73bb\u7483\u5411\u5916\u6563\u5931\uff0c\u5ba4\u5916\u70ed\u8f90\u5c04\u4e5f\u66f4\u5bb9\u6613\u8fdb\u5165\u5ba4\u5185\u3002</p> <p>Low-E = \u4f4e\u8f90\u5c04\u7387\uff0c\u610f\u601d\u662f\u8fd9\u79cd\u73bb\u7483\u5bf9\u70ed\u8f90\u5c04\u7684\u4f20\u9012\u80fd\u529b\u66f4\u4f4e\u3002</p>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#_1","title":"\u5b83\u5728\u5e55\u5899\u73bb\u7483\u4e2d\u8d77\u4ec0\u4e48\u4f5c\u7528\uff1f","text":"<p>\u4e3b\u8981\u6709\u4e09\u4e2a\u4f5c\u7528\uff1a</p> <ol> <li> <p>\u9694\u70ed</p> <p>Low-E \u819c\u5c42\u53ef\u4ee5\u53cd\u5c04\u4e00\u90e8\u5206\u7ea2\u5916\u70ed\u8f90\u5c04\u3002\u590f\u5929\u65f6\uff0c\u5b83\u53ef\u4ee5\u51cf\u5c11\u5ba4\u5916\u592a\u9633\u70ed\u91cf\u8fdb\u5165\u5ba4\u5185\uff1b\u51ac\u5929\u65f6\uff0c\u5b83\u53ef\u4ee5\u51cf\u5c11\u5ba4\u5185\u6696\u6c14\u70ed\u91cf\u5411\u5916\u6d41\u5931\u3002   \u6240\u4ee5\u5b83\u5e38\u7528\u4e8e\uff1a\u529e\u516c\u697c\u5e55\u5899\u3001\u9152\u5e97\u5916\u7acb\u9762\u3001\u673a\u573a\u3001\u5546\u573a\u3001\u9ad8\u6863\u4f4f\u5b85\u95e8\u7a97\u7b49\u3002</p> </li> <li> <p>\u8282\u80fd</p> <p>\u56e0\u4e3a\u9694\u70ed\u6548\u679c\u66f4\u597d\uff0c\u7a7a\u8c03\u548c\u91c7\u6696\u8d1f\u8377\u4f1a\u964d\u4f4e\u3002\u4e5f\u5c31\u662f\u8bf4\uff0c\u5efa\u7b51\u7269\u4e3a\u4e86\u7ef4\u6301\u5ba4\u5185\u6e29\u5ea6\uff0c\u9700\u8981\u6d88\u8017\u7684\u7535\u80fd\u4f1a\u51cf\u5c11\u3002\u6240\u4ee5 Low-E \u73bb\u7483\u672c\u8d28\u4e0a\u662f\u4e00\u79cd\u5efa\u7b51\u8282\u80fd\u73bb\u7483\u3002</p> </li> <li> <p>\u6539\u5584\u8212\u9002\u5ea6</p> <p>\u666e\u901a\u73bb\u7483\u9644\u8fd1\u5bb9\u6613\u51fa\u73b0\u201c\u51ac\u5929\u51b7\u3001\u590f\u5929\u6652\u201d\u7684\u611f\u89c9\u3002Low-E \u73bb\u7483\u53ef\u4ee5\u51cf\u5f31\u8fd9\u79cd\u51b7\u70ed\u8f90\u5c04\u611f\uff0c\u8ba9\u9760\u8fd1\u73bb\u7483\u5e55\u5899\u7684\u4f4d\u7f6e\u66f4\u8212\u670d\u3002</p> </li> </ol>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#low-e_1","title":"\u201c\u53cc\u5c42\u4e2d\u7a7a\u5939\u5fc3\u73bb\u7483\u201d\u91cc Low-E \u901a\u5e38\u5728\u54ea\u91cc\uff1f","text":"<p>\u5e55\u5899\u4e2d\u5e38\u89c1\u7ed3\u6784\u5927\u81f4\u662f\uff1a\u5916\u7247\u73bb\u7483 + \u4e2d\u7a7a\u5c42 + \u5185\u7247\u73bb\u7483</p> <p>Low-E \u819c\u5c42\u4e00\u822c\u9540\u5728\u67d0\u4e00\u7247\u73bb\u7483\u671d\u5411\u4e2d\u7a7a\u5c42\u7684\u4e00\u9762\uff0c\u4e0d\u662f\u76f4\u63a5\u66b4\u9732\u5728\u5ba4\u5916\u6216\u5ba4\u5185\u7a7a\u6c14\u4e2d\u3002\u8fd9\u6837\u53ef\u4ee5\u4fdd\u62a4\u819c\u5c42\uff0c\u907f\u514d\u6c27\u5316\u3001\u5212\u4f24\u3001\u6c61\u67d3\u3002</p> <p>\u4f8b\u5982\u5e38\u89c1\u8bf4\u6cd5\uff1a6Low-E + 12A + 6 \u7684\u610f\u601d\u662f\uff1a</p> <ul> <li>6mm Low-E \u73bb\u7483 + 12mm \u7a7a\u6c14\u5c42 + 6mm \u666e\u901a\u73bb\u7483</li> </ul> <p>\u5176\u4e2d\uff1a</p> <ul> <li>6 = \u73bb\u7483\u539a\u5ea6 6mm\uff1b</li> <li>12A = 12mm air space\uff0c\u5373 12mm \u4e2d\u7a7a\u7a7a\u6c14\u5c42\uff1b</li> <li>Low-E = \u5176\u4e2d\u4e00\u7247\u73bb\u7483\u5e26\u4f4e\u8f90\u5c04\u9540\u819c</li> </ul>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#low-e_2","title":"Low-E \u548c\u666e\u901a\u4e2d\u7a7a\u73bb\u7483\u6709\u4ec0\u4e48\u533a\u522b\uff1f","text":"<p>\u666e\u901a\u4e2d\u7a7a\u73bb\u7483\u4e3b\u8981\u9760\u4e2d\u95f4\u7a7a\u6c14\u5c42\u9694\u70ed\u3001\u9694\u97f3\u3002 Low-E \u4e2d\u7a7a\u73bb\u7483\u5219\u662f\u5728\u666e\u901a\u4e2d\u7a7a\u73bb\u7483\u57fa\u7840\u4e0a\u53c8\u589e\u52a0\u4e86\u9540\u819c\u5c42\uff0c\u6240\u4ee5\u8282\u80fd\u6027\u80fd\u66f4\u597d\u3002</p> <p>\u53ef\u4ee5\u7b80\u5355\u7406\u89e3\u4e3a\uff1a</p> <ul> <li> <p>\u666e\u901a\u4e2d\u7a7a\u73bb\u7483 = \u73bb\u7483 + \u7a7a\u6c14\u5c42\u9694\u70ed\uff1b</p> </li> <li> <p>Low-E \u4e2d\u7a7a\u73bb\u7483 = \u73bb\u7483 + \u7a7a\u6c14\u5c42 + \u9540\u819c\u53cd\u5c04\u70ed\u8f90\u5c04</p> </li> </ul> <p>\u6240\u4ee5 Low-E \u4e2d\u7a7a\u73bb\u7483\u901a\u5e38\u6bd4\u666e\u901a\u4e2d\u7a7a\u73bb\u7483\u66f4\u8d35\uff0c\u4f46\u9694\u70ed\u8282\u80fd\u6548\u679c\u4e5f\u66f4\u597d\u3002</p>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#_2","title":"\u5b83\u4f1a\u4e0d\u4f1a\u5f71\u54cd\u91c7\u5149\uff1f","text":"<p>\u4f1a\u6709\u4e00\u5b9a\u5f71\u54cd\uff0c\u4f46\u4e0d\u4e00\u5b9a\u660e\u663e\u3002</p> <p>Low-E \u73bb\u7483\u53ef\u4ee5\u505a\u5230\u6bd4\u8f83\u9ad8\u7684\u53ef\u89c1\u5149\u900f\u8fc7\u7387\uff0c\u540c\u65f6\u964d\u4f4e\u7ea2\u5916\u70ed\u91cf\u8fdb\u5165\u3002\u597d\u7684 Low-E \u73bb\u7483\u53ef\u4ee5\u5b9e\u73b0\uff1a</p> <p>\u5149\u80fd\u8fdb\u6765\u8f83\u591a\uff0c\u70ed\u91cf\u8fdb\u6765\u8f83\u5c11\u3002</p> <p>\u4e0d\u8fc7\u4e0d\u540c\u578b\u53f7\u5dee\u5f02\u5f88\u5927\u3002\u6709\u4e9b Low-E \u73bb\u7483\u989c\u8272\u8f83\u6d45\u3001\u901a\u900f\u6027\u597d\uff1b\u6709\u4e9b\u4e3a\u4e86\u906e\u9633\u9694\u70ed\uff0c\u989c\u8272\u4f1a\u66f4\u6df1\uff0c\u53cd\u5c04\u611f\u66f4\u5f3a\u3002</p>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#_3","title":"\u4e00\u53e5\u8bdd\u603b\u7ed3\uff1a","text":"<p>Low-E \u5c31\u662f\u201c\u4f4e\u8f90\u5c04\u9540\u819c\u73bb\u7483\u201d\uff0c\u5728\u53cc\u5c42\u4e2d\u7a7a\u5e55\u5899\u73bb\u7483\u4e2d\u4e3b\u8981\u7528\u4e8e\u9694\u70ed\u3001\u4fdd\u6e29\u3001\u8282\u80fd\uff0c\u8ba9\u5efa\u7b51\u7a7a\u8c03\u548c\u91c7\u6696\u80fd\u8017\u66f4\u4f4e\u3002</p>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#low-e_3","title":"==\u95ee\u9898\u4e8c\uff1alow e \u73bb\u7483\u4e00\u5b9a\u4f1a\u6709\u4e00\u70b9\u989c\u8272\u5417\uff0c\u53ef\u4ee5\u505a\u6210\u662f\u7eaf\u900f\u660e\u7684\u5417\uff1f==","text":"<p>Low-E \u73bb\u7483\u901a\u5e38\u4f1a\u6709\u4e00\u70b9\u989c\u8272\u6216\u53cd\u5c04\u611f\uff0c\u4f46\u4e0d\u4e00\u5b9a\u660e\u663e\uff1b\u53ef\u4ee5\u505a\u5f97\u975e\u5e38\u63a5\u8fd1\u201c\u7eaf\u900f\u660e\u201d\uff0c\u4f46\u4e25\u683c\u610f\u4e49\u4e0a\u5f88\u96be\u505a\u5230\u548c\u666e\u901a\u767d\u73bb\u4e00\u6a21\u4e00\u6837\u3002</p> <p>\u66f4\u51c6\u786e\u5730\u8bf4\uff1a</p> <ul> <li>Low-E \u73bb\u7483\u4e0d\u662f\u9760\u67d3\u8272\u8d77\u4f5c\u7528\uff0c\u800c\u662f\u9760\u4e00\u5c42\u6781\u8584\u7684\u91d1\u5c5e / \u91d1\u5c5e\u6c27\u5316\u7269\u9540\u819c\u8d77\u4f5c\u7528\u3002</li> <li>\u8fd9\u5c42\u819c\u4f1a\u5f71\u54cd\u5149\u7ebf\u900f\u8fc7\u548c\u53cd\u5c04\uff0c\u6240\u4ee5\u5b83\u5f80\u5f80\u4f1a\u5e26\u6765\u8f7b\u5fae\u7684\u989c\u8272\u503e\u5411\uff0c\u4f8b\u5982\uff1a</li> <li>\u5fae\u5fae\u504f\u84dd\uff1b</li> <li>\u5fae\u5fae\u504f\u7eff\uff1b</li> <li>\u5fae\u5fae\u504f\u7070\uff1b </li> </ul> <p>\u4ece\u67d0\u4e9b\u89d2\u5ea6\u770b\u6709\u8f7b\u5fae\u955c\u9762\u53cd\u5c04\u3002\u5ba4\u5916\u770b\u989c\u8272\u66f4\u660e\u663e\uff0c\u5ba4\u5185\u770b\u53ef\u80fd\u4e0d\u660e\u663e\u3002</p> <p>\u4e0d\u8fc7\u73b0\u5728\u9ad8\u900f\u578b Low-E \u6280\u672f\u5df2\u7ecf\u6bd4\u8f83\u6210\u719f\uff0c\u53ef\u4ee5\u505a\u5f97\u975e\u5e38\u901a\u900f\u3001\u989c\u8272\u5f88\u6d45\uff0c\u8089\u773c\u770b\u4e0a\u53bb\u63a5\u8fd1\u666e\u901a\u900f\u660e\u73bb\u7483\u3002</p>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#_4","title":"\u80fd\u4e0d\u80fd\u505a\u6210\u201c\u7eaf\u900f\u660e\u201d\uff1f","text":"<p>\u8981\u770b\u4f60\u8bf4\u7684\u201c\u7eaf\u900f\u660e\u201d\u662f\u54ea\u79cd\u6807\u51c6\u3002</p> <p>\u5982\u679c\u662f\u65e5\u5e38\u8089\u773c\u611f\u53d7\uff1a\u53ef\u4ee5\u3002</p> <ul> <li>\u53ef\u4ee5\u9009\u62e9 \u9ad8\u900f Low-E \u73bb\u7483 / \u8d85\u767d Low-E \u73bb\u7483 / \u9ad8\u900f\u578b\u4f4e\u8f90\u5c04\u73bb\u7483\uff0c\u6548\u679c\u53ef\u4ee5\u63a5\u8fd1\u666e\u901a\u900f\u660e\u73bb\u7483\u3002</li> </ul> <p>\u5982\u679c\u662f\u4e25\u683c\u4ece\u5149\u5b66\u89d2\u5ea6\uff1a</p> <ul> <li>\u5f88\u96be\u5b8c\u5168\u65e0\u8272\u3002\u56e0\u4e3a\u53ea\u8981\u6709 Low-E \u9540\u819c\uff0c\u5c31\u4f1a\u5bf9\u53ef\u89c1\u5149\u548c\u7ea2\u5916\u7ebf\u4ea7\u751f\u9009\u62e9\u6027\u53cd\u5c04\uff0c\u4e0d\u53ef\u80fd\u5b8c\u5168\u7b49\u540c\u4e8e\u4e00\u5757\u6ca1\u6709\u9540\u819c\u7684\u666e\u901a\u767d\u73bb\u3002</li> </ul>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#_5","title":"\u5982\u679c\u4f60\u60f3\u8981\u5e55\u5899\u770b\u8d77\u6765\u5c3d\u91cf\u900f\u660e\uff0c\u5e94\u8be5\u600e\u4e48\u9009\uff1f","text":"<p>\u4f18\u5148\u8003\u8651\u8fd9\u51e0\u7c7b\uff1a</p> <ol> <li> <p>\u9ad8\u900f Low-E \u73bb\u7483 \u91cd\u70b9\u770b\u53c2\u6570\u91cc\u7684 Visible Light Transmittance\uff0c\u53ef\u89c1\u5149\u900f\u8fc7\u7387\u3002\u6570\u503c\u8d8a\u9ad8\uff0c\u8d8a\u901a\u900f\u3002</p> </li> <li> <p>\u8d85\u767d\u73bb + Low-E \u9540\u819c \u666e\u901a\u6d6e\u6cd5\u73bb\u7483\u672c\u8eab\u4f1a\u6709\u4e00\u70b9\u7eff\u8272\uff0c\u5c24\u5176\u73bb\u7483\u8d8a\u539a\u8d8a\u660e\u663e\u3002 \u5982\u679c\u60f3\u8981\u66f4\u6e05\u900f\uff0c\u53ef\u4ee5\u7528 \u8d85\u767d\u73bb\uff0c\u4e5f\u53eb low-iron glass / ultra-clear glass\u3002 \u5b83\u672c\u8eab\u94c1\u542b\u91cf\u4f4e\uff0c\u7eff\u8272\u611f\u66f4\u5f31\u3002</p> </li> <li> <p>\u4e2d\u6027\u8272 Low-E \u9540\u819c \u6709\u4e9b Low-E \u504f\u84dd\u3001\u504f\u7070\u3001\u504f\u94f6\uff0c\u6709\u4e9b\u5219\u66f4\u63a5\u8fd1\u4e2d\u6027\u8272\u3002 \u5982\u679c\u4e1a\u4e3b\u8981\u6c42\u7acb\u9762\u901a\u900f\u3001\u989c\u8272\u6d45\uff0c\u5c31\u5e94\u8be5\u8981\u6c42\u4f9b\u5e94\u5546\u63d0\u4f9b neutral appearance / clear appearance \u7c7b\u578b\u7684 Low-E\u3002</p> </li> </ol>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#_6","title":"\u9700\u8981\u6ce8\u610f\u4e00\u4e2a\u6b64\u6d88\u5f7c\u957f\u7684\u73b0\u5b9e\u95ee\u9898\uff1a","text":"<p>\u8d8a\u8ffd\u6c42\u201c\u7eaf\u900f\u660e\u3001\u9ad8\u900f\u5149\u201d\uff0c\u901a\u5e38\u906e\u9633\u9694\u70ed\u80fd\u529b\u53ef\u80fd\u4f1a\u6709\u6240\u4e0b\u964d\u3002</p> <ul> <li>\u8d8a\u900f\u660e\uff0c\u592a\u9633\u70ed\u91cf\u8d8a\u5bb9\u6613\u8fdb\u6765\uff1b</li> <li>\u8d8a\u5f3a\u9694\u70ed\uff0c\u989c\u8272\u548c\u53cd\u5c04\u611f\u5f80\u5f80\u8d8a\u660e\u663e\u3002</li> </ul>"},{"location":"%E4%B8%83%E5%B9%B4%E7%BA%A7/#_7","title":"\u4e00\u53e5\u8bdd\u6982\u62ec\uff1a","text":"<p>Low-E \u53ef\u4ee5\u505a\u5f97\u5f88\u63a5\u8fd1\u900f\u660e\uff0c\u4f46\u53ea\u8981\u6709\u9540\u819c\uff0c\u5c31\u5f88\u96be\u505a\u5230\u5b8c\u5168\u50cf\u666e\u901a\u65e0\u819c\u73bb\u7483\u4e00\u6837\u201c\u7edd\u5bf9\u7eaf\u900f\u660e\u3001\u65e0\u8272\u3001\u65e0\u53cd\u5c04\u201d\u3002</p>"}]}